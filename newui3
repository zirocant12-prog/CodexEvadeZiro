            pcall(function()
                avatar.Image = Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            end)
            local ac = Instance.new("UICorner") ac.CornerRadius = UDim.new(1, 0) ac.Parent = avatar

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Parent = pCard
            nameLabel.BackgroundTransparency = 1
            nameLabel.Position = UDim2.new(0, 38, 0, 0)
            nameLabel.Size = UDim2.new(1, -140, 1, 0)
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.Text = plr.Name .. " (@" .. plr.DisplayName .. ")"
            nameLabel.TextColor3 = color_dark_text
            nameLabel.TextSize = 10
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left

            -- Info Button
            local infoBtn = Instance.new("TextButton")
            infoBtn.Parent = pCard
            infoBtn.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
            infoBtn.BackgroundTransparency = 0.3
            infoBtn.Position = UDim2.new(1, -95, 0, 6)
            infoBtn.Size = UDim2.new(0, 42, 0, 24)
            infoBtn.Font = Enum.Font.GothamBold
            infoBtn.Text = "INFO"
            infoBtn.TextColor3 = color_dark_text
            infoBtn.TextSize = 9
            local ibc = Instance.new("UICorner") ibc.CornerRadius = UDim.new(0, 4) ibc.Parent = infoBtn

            infoBtn.MouseButton1Click:Connect(function()
                PimAvatar.Image = avatar.Image
                PimDetailsBox.Text = "Fetching full information, country & old usernames..."
                PlayerInfoModal.Visible = true

                task.spawn(function()
                    local accountAgeYears = math.floor((plr.AccountAge / 365) * 10) / 10
                    local charState = (plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") and plr.Character.Humanoid.Health > 0) and "Alive" or "Dead/Respawning"
                    local teamName = plr.Team and plr.Team.Name or "None"
                    
                    -- Detect Country/Region dynamically using LocalizationService
                    local countryName = "Unknown / Global"
                    pcall(function()
                        local cCode = LocalizationService:GetCountryRegionForPlayerAsync(plr)
                        if cCode and cCode ~= "" then
                            countryName = cCode
                        end
                    end)

                    -- Detect Device Platform (Mobile vs PC/Console)
                    local deviceType = "PC / Computer"
                    pcall(function()
                        -- Check for touch capability or mobile GUI elements
                        if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
                            deviceType = "Mobile (Phone/Tablet)"
                        elseif UserInputService.TouchEnabled and UserInputService.KeyboardEnabled then
                            deviceType = "Tablet / Hybrid"
                        else
                            deviceType = "PC / Desktop"
                        end
                    end)

                    -- Fetching previous/old usernames using Roblox web API via HttpService/proxy or fallback
                    local oldUsernamesList = "None / Private"
                    local success, res = pcall(function()
                        local url = "https://users.roblox.com/v1/users/" .. plr.UserId .. "/username-history"
                        local response = game:HttpGet(url)
                        local decoded = HttpService:JSONDecode(response)
                        if decoded and decoded.data then
                            local names = {}
                            for _, entry in ipairs(decoded.data) do
                                table.insert(names, entry.name)
                            end
                            if #names > 0 then
                                oldUsernamesList = table.concat(names, ", ")
                            else
                                oldUsernamesList = "No previous usernames"
                            end
                        end
                    end)

                    if not success then
                        oldUsernamesList = "Unavailable (API Restricted)"
                    end

                    PimDetailsBox.Text = string.format(
                        "Username: %s\nDisplay Name: %s\nCountry/Region: %s\nDevice: %s\nOld Usernames: %s\nUser ID: %s\nAccount Age: %d days (~%.1f yrs)\nTeam: %s\nStatus: %s",
                        plr.Name, plr.DisplayName, countryName, deviceType, oldUsernamesList, tostring(plr.UserId), plr.AccountAge, accountAgeYears, teamName, charState
                    )
                end)
            end)

            -- TP Button
            local tpBtn = Instance.new("TextButton")
            tpBtn.Parent = pCard
            tpBtn.BackgroundColor3 = current_accent
            tpBtn.BorderSizePixel = 0
            tpBtn.Position = UDim2.new(1, -48, 0, 6)
            tpBtn.Size = UDim2.new(0, 42, 0, 24)
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.Text = "TP"
            tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tpBtn.TextSize = 9
            local tpc = Instance.new("UICorner") tpc.CornerRadius = UDim.new(0, 4) tpc.Parent = tpBtn
            table.insert(accentDependentBlades, tpBtn)

            tpBtn.MouseButton1Click:Connect(function()
                pcall(function()
                    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        showNotification("Teleported to " .. plr.Name)
                    else
                        showNotification("Cannot TP to this player!")
                    end
                end)
            end)
        end
    end

