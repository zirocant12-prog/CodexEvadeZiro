local function UpdateAllAccents(newColor)
    current_accent = newColor
    for _, stroke in ipairs(accentDependentStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = newColor
        end
    end
    for _, blade in ipairs(accentDependentBlades) do
        if blade and blade.Parent then
            blade.BackgroundColor3 = newColor
        end
    end
    for _, scroll in ipairs(accentDependentScrollbars) do
        if scroll and scroll.Parent then
            scroll.ScrollBarImageColor3 = newColor
        end
    end
    for _, drawing in ipairs(accentDependentDrawings) do
        if drawing then
            drawing.Color = newColor
        end
    end
end

