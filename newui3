local BuildMainUI

SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyBox.Text
    if enteredKey == "" then
        showNotification("Please enter a key!")
        return
    end

    SubmitBtn.Text = "CHECKING..."
    
    task.spawn(function()
        local success, result = pcall(function()
            local url = "https://wrxlogintracker-default-rtdb.firebaseio.com/keys/" .. enteredKey .. ".json"
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result then
            if result.blocked == true then
                showNotification("This key has been BLOCKED!")
                SubmitBtn.Text = "LOGIN"
                return
            end

            if result.expiry then
                local year, month, day, hour, min, ampm = result.expiry:match("(%d+)-(%d+)-(%d+) (%d+):(%d+)%s*(%a*)")
                if year then
                    hour = tonumber(hour)
                    min = tonumber(min)
                    ampm = ampm:upper()
                    
                    if ampm == "PM" and hour < 12 then
                        hour = hour + 12
                    elseif ampm == "AM" and hour == 12 then
                        hour = 0
                    end

                    local expTable = {
                        year = tonumber(year),
                        month = tonumber(month),
                        day = tonumber(day),
                        hour = hour,
                        min = min,
                        sec = 0
                    }
                    
                    local expEpoch = os.time(expTable)
                    if os.time() > expEpoch then
                        showNotification("Key has EXPIRED!")
                        SubmitBtn.Text = "LOGIN"
                        return
                    end
                end
            end

            local currentUses = tonumber(result.uses) or 0
            local maxAllowedUses = tonumber(result.maxUses) or 999999
            if currentUses >= maxAllowedUses then
                showNotification("Key has reached its Maximum Uses limit!")
                SubmitBtn.Text = "LOGIN"
                return
            end

            pcall(function()
                local updateUrl = "https://wrxlogintracker-default-rtdb.firebaseio.com/keys/" .. enteredKey .. ".json"
                local requestFunc = syn and syn.request or http_request or request
                if requestFunc then
                    requestFunc({
                        Url = updateUrl,
                        Method = "PATCH",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = HttpService:JSONEncode({uses = currentUses + 1, lastUser = LocalPlayer.Name})
                    })
                end
            end)

            showNotification("Login Successful! Welcome, " .. LocalPlayer.Name)
            Tween(LoginFrame, "Size", UDim2.new(0, 0, 0, 0), 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.wait(0.3)
            LoginFrame:Destroy()
            
            BuildMainUI()

        else
            showNotification("Invalid Key or Database Error!")
            SubmitBtn.Text = "LOGIN"
        end
    end)
end)


